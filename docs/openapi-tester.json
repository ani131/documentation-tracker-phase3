{
  "openapi": "3.1.1",
  "info": {
    "title": "Documentation Tracker tester",
    "version": "3.0.0",
    "description": "Phase 3 implementation contract based on Phase 2 v1 and the course testing interface. Clarifications await pod agreement; this is not evidence of approval."
  },
  "servers": [
    {
      "url": "/tester"
    }
  ],
  "paths": {
    "/test/setup": {
      "post": {
        "summary": "Create a session; prepare the approved target without running tests",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "target_url"
                ],
                "additionalProperties": false,
                "properties": {
                  "target_url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "session_id"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "session_id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9_-]{1,80}$"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message",
                    "source"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source": {
                      "enum": [
                        "tester",
                        "system",
                        "communication",
                        "unknown"
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Response",
            "content": {
              "application/json": {
