    "/test/run": {
      "post": {
        "summary": "Run one complete suite exactly once per session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "session_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "session_id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_-]{1,80}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "session_id",
                    "target_url",
                    "results",
                    "coverage"
                  ],
                  "properties": {
                    "session_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "target_url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "test_id",
                          "outcome",
                          "message"
                        ],
                        "properties": {
                          "test_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "outcome": {
                            "enum": [
                              "pass",
                              "fail",
                              "error",
                              "skip"
                            ]
                          },
                          "message": {
                            "type": "string",
                            "minLength": 1
                          },
                          "source": {
                            "enum": [
                              "tester",
                              "system",
                              "communication",
                              "unknown"
                            ]
                          }
                        },
                        "allOf": [
                          {
                            "if": {
                              "properties": {
                                "outcome": {
                                  "const": "error"
                                }
                              }
                            },
                            "then": {
                              "required": [
                                "source"
                              ]
                            }
                          }
                        ]
                      }
                    },
                    "coverage": {
                      "type": "object",
                      "required": [
                        "code",
                        "component",
                        "system"
                      ],
                      "properties": {
                        "code": {
                          "type": "object",
                          "required": [
                            "covered",
                            "total",
                            "basis"
                          ],
                          "properties": {
                            "covered": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 0
                            },
                            "total": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 0
                            },
                            "basis": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "component": {
                          "type": "object",
                          "required": [
                            "covered",
                            "total",
                            "basis"
                          ],
                          "properties": {
                            "covered": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 0
                            },
                            "total": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 0
                            },
                            "basis": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "system": {
                          "type": "object",
                          "required": [
                            "covered",
                            "total",
                            "basis"
                          ],
                          "properties": {
                            "covered": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 0
                            },
                            "total": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 0
                            },
                            "basis": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message",
                    "source"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source": {
                      "enum": [
                        "tester",
                        "system",
                        "communication",
                        "unknown"
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
