    "/test/report": {
      "get": {
        "summary": "Return per-session code coverage availability",
        "responses": {
          "200": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "session_id",
                    "coverage"
                  ],
                  "properties": {
                    "session_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "coverage": {
                      "type": "object",
                      "required": [
                        "code"
                      ],
                      "properties": {
                        "code": {
                          "type": "object",
                          "required": [
                            "covered",
                            "total",
                            "basis"
                          ],
                          "properties": {
                            "covered": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 0
                            },
                            "total": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 0
                            },
                            "basis": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      }
                    }
