{
  "openapi": "3.1.1",
  "info": {
    "title": "Documentation Tracker system",
    "version": "3.0.0",
    "description": "Phase 3 implementation contract based on Phase 2 v1 and the course testing interface. Clarifications await pod agreement; this is not evidence of approval."
  },
  "servers": [
    {
      "url": "/system"
    }
  ],
  "paths": {
    "/analyze": {
      "post": {
        "summary": "Resolve public GitHub commits, classify changes and save immutable JSON evidence",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "repository",
                  "commit_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "repository": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}$"
                  },
                  "commit_id": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{7,40}$"
                  },
                  "base_commit": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{7,40}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "analysis_id",
                    "repository",
                    "head_commit",
                    "base_commit",
                    "configuration_version",
                    "tool_version",
                    "created_at",
                    "status",
                    "changes",
                    "issues",
                    "skipped",
                    "error"
                  ],
                  "properties": {
                    "analysis_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "repository": {
                      "type": "string",
                      "minLength": 1
                    },
                    "head_commit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "base_commit": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "configuration_version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tool_version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "status": {
                      "enum": [
                        "SUCCESS",
                        "ERROR"
                      ]
                    },
                    "changes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "path",
                          "change_type",
                          "category"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "path": {
                            "type": "string",
                            "minLength": 1
                          },
                          "change_type": {
                            "enum": [
                              "ADDED",
                              "MODIFIED",
                              "DELETED"
                            ]
                          },
                          "category": {
                            "enum": [
                              "IMPLEMENTATION",
                              "DESIGN",
                              "ARCHITECTURE",
                              "SPECIFICATION",
                              "REQUIREMENT",
                              "OTHER"
                            ]
                          }
                        }
                      }
                    },
                    "issues": {
                      "type": "array",
                      "maxItems": 0,
                      "items": {
                        "type": "object"
                      }
                    },
                    "skipped": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "path",
                          "reason"
                        ],
                        "properties": {
                          "path": {
                            "type": "string",
                            "minLength": 1
                          },
                          "reason": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    },
                    "error": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "required": [
                            "code",
                            "message"
                          ],
                          "properties": {
                            "code": {
                              "type": "string",
                              "minLength": 1
                            },
                            "message": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message",
                    "source"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source": {
                      "enum": [
                        "tester",
                        "system",
                        "communication",
                        "unknown"
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message",
                    "source"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source": {
                      "enum": [
                        "tester",
                        "system",
                        "communication",
                        "unknown"
                      ]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message",
                    "source"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source": {
                      "enum": [
                        "tester",
                        "system",
                        "communication",
                        "unknown"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-Test-Session",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            }
          }
        ]
      }
    },
