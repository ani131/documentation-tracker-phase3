    "/test/setup": {
      "post": {
        "summary": "Register supplied session; no fixture mutation or reset",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "session_id",
                  "setup"
                ],
                "additionalProperties": false,
                "properties": {
                  "session_id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_-]{1,80}$"
                  },
                  "setup": {
                    "type": "object",
                    "maxProperties": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "session_id"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "session_id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9_-]{1,80}$"
                    }
                  }
                }
              }
            }
          },
          "400": {
